@{
    Layout = "_Player";
}

@model MvcMovie.Models.Video

@{
    ViewData["Title"] = "Player";
}

@{
    Episode? episode = ViewData["Episode"] as MvcMovie.Models.Episode;
    Episode? nextEpisode = ViewData["NextEpisode"] as MvcMovie.Models.Episode;
}

<script src="https://kit.fontawesome.com/efe6a73c66.js" crossorigin="anonymous"></script>
<style>
    video {
        position: absolute;
    }

    ::cue {
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        background-color: transparent;
        font-size: smaller;


    }

    #video-controls[data-state="shown"] {
        position: absolute;
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        z-index: 999;
    }

    #video-controls[data-state="hidden"] {
        height: 100vh;
        width: 100vw;
        position: absolute;
        visibility: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;

        -webkit-transition: visibility 0.5s, opacity 0.5s;
        -moz-transition: visibility 0.5s, opacity 0.5s;
        -ms-transition: visibility 0.5s, opacity 0.5s;
        -o-transition: visibility 0.5s, opacity 0.5s;
        transition: visibility 0.5s, opacity 0.5s;

        /* Wait a moment before fading out the control bar */
        -webkit-transition-delay: 1s;
        -moz-transition-delay: 1s;
        -ms-transition-delay: 1s;
        -o-transition-delay: 1s;
        transition-delay: 1s;
    }

    #video-controls button {
        display: flex;
        height: 2rem;
        margin: 1rem;
        color: white;
        background: none;
        border: none;
        font-weight: bolder;
        font-size: large;
        vertical-align: middle;
        align-items: center;
        z-index: 9999;
    }

    #top-controls {
        flex-direction: row;
    }

    #center-controls {
        flex-grow: 1;
        align-content: center;
    }

    #play-controls {
        display: flex;
        flex-direction: row;
    }

    #bottom-controls {
        width: 100vw;

        display: flex;
        height: 5rem;
        background: black;
        align-content: space-between;
        background: none;
        background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 1));
    }

    #captions-list {
        visibility: hidden;
        padding: 5px;
        position: absolute;
        background-color: rgba(0, 0, 0, 0.5);
        bottom: 50px;
        right: 60px
    }

    #captions-list>li {
        list-style-type: none;
        font-size: smaller;
        font-weight: lighter;
        padding: 5px;
    }

    .caption-li:hover {
        font-weight: 900;
        text-decoration: underline;
    }

    #progress-bar {
        -webkit-appearance: none;
        position: relative;
        left: 0;
        right: 0;
        bottom: 0.75rem;
        width: auto;
        height: 4px;
        border-radius: 5px;
    }

    #progress-slider {
        -webkit-appearance: none;
        position: relative;
        bottom: -0.75rem;
        background: none;
        height: 4px;
        z-index: 10;
    }

    progress::-webkit-progress-bar {
        background-color: grey;
        border-radius: 7px;
    }

    progress::-webkit-progress-value {
        background-color: royalblue;
        border-radius: 7px;
        box-shadow: 1px 1px 5px 3px rgba(255, 255, 255, 0.1);
    }


    .slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        position: relative;
        bottom: 0;
        width: 1rem;
        height: 1rem;
        background: white;
        border-radius: 50%;
        cursor: pointer;
    }

    .next-episode {
        position: relative;
        display: flex;
        margin: 0px 0px 20px 20px;
        padding: 10px;
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 5px;
        font-weight: bold;
    }


    #next-episode-timer {
        -webkit-appearance: none;
        top: 0;
        left: 0;
        position: absolute;
        width: 100%;
        height: 100%;
        margin: 0px;
        background: transparent;
        padding: 0px;
        z-index: -1;
    }

    #next-episode-timer::-webkit-progress-bar {
        background: none;
        border-radius: 5px;
        box-shadow: none;
    }

    #next-episode-timer::-webkit-progress-value {
        background: rgba(255, 255, 255, 0.5);
        border-radius: 5px;
        transition: width 1s linear;
        box-shadow: none;
    }

    .watch-credits {
        margin-bottom: 20px;
        padding: 10px;
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 5px;
        font-weight: bold;

    }

    .next-episode-controls {
        display: flex;
        justify-items: space-between;
        visibility: hidden;
        position: absolute;
        bottom: 5%;
        right: 2%;
        margin: 20px;
        z-index: 1000;
    }
</style>

<div class="text-center" id="player-container" style="background-color: black; position:static;">
    <video id="video" style="display:flex; height: 100dvh; width: 100vw; position: fixed; background-color: black;"
        autoplay disableRemotePlayback preload="metadata" src="/Videos/Stream/@Model.Id" tabindex="-1" data-timestamp=@Model.LastWatchedTimestamp />
    <track label="English" kind="subtitles" id="subtitles" srclang="en" src="/Videos/Subtitles/@Model.Id?lang=Eng" default />
    <track label="French" kind="subtitles" id="subtitles" srclang="fr" src="/Videos/Subtitles/@Model.Id?lang=Fr" />
    <track label="Spanish" kind="subtitles" id="subtitles" srclang="es" src="/Videos/Subtitles/@Model.Id?lang=Sp" />
    </video>
    <div id="video-controls" class="" data-state="shown">
        <div id="top-controls">
            @if (episode != null)
            {
                <button id="back" onclick="location.href='/Shows/@(episode.Season.ShowId)/Season/@(episode.SeasonNumber)'"
                    class="playerNav" tabindex="0">
                    <i class="fa-solid fa-arrow-left m-2"></i>
                    Back
                </button>
            }
            else
            {
                <button id="back" onclick="history.back()" class="playerNav" tabindex="0">
                    <i class="fa-solid fa-arrow-left m-2"></i>
                    Back
                </button>
            }
            <button id="restart" class="playerNav" tabindex="0"><i
                    class="fa-solid fa-arrow-rotate-left m-2"></i>Restart</button>
            @if (episode != null)
            {
                <h2 class="text-white mx-auto" id="video-title">Season @episode.SeasonNumber Episode @episode.EpisodeNumber
                    - @episode.Title</h2>
            }

        </div>
        <div id="center-controls" class="justify-content-center align-self-center">
            <span class="text-white" id="play-controls">
                <button id="rewind-btn" class="fs-1" tabindex="-1"><i class="fa-solid fa-backward mx-3"></i></button>
                <button id="play-pause-btn" class="fs-1" tabindex="-1"><i id="play-pause-icon"
                        class="fa-solid fa-pause mx-3"></i></button>
                <button id="forward-btn" class="fs-1" tabindex="-1"><i class="fa-solid fa-forward mx-3"></i></button>
            </span>

        </div>
        <div id="bottom-controls">
            <span class="text-white m-3 lh-0.5" id="current-time"></span>
            <div class="w-100 move" id="progress">
                <input type="range" min="0" max="100" step="any" value="0" class="slider  playerNav w-100"
                    id="progress-slider" tabindex="0">
                <progress id="progress-bar" value="0" max="100" class="w-100"> </progress>
            </div>
            <span class="text-white m-3" id="duration"></span>
            <button id="captions-btn" class="playerNav">
                <i id="captions-icon" class="fa-solid fa-closed-captioning"></i>
                <ul id="captions-list"">
                   <li class=" caption-li playerNav" tabindex="0" role="button">Off</li>
                </ul>

            </button>
            <button id="fullscreen" class="playerNav" tabindex="0">
                <i id="fullscreen-icon" class="fa-solid fa-expand"></i>
            </button>

        </div>

    </div>
    @if (nextEpisode != null)
    {
        <div class="next-episode-controls">
            <button type="button" tabindex="0" onclick="watchCredits()" class="watch-credits playerNav">Watch Credits</button>
            <button type="button" tabindex="0" id="next-episode" class="next-episode playerNav"
                onclick="location.href='/Videos/Player/@(nextEpisode.Video.Id)'">
                ▶ Next Episode
                <progress id="next-episode-timer" value="0" max="10" class="w-100" />
            </button>

        </div>
    }
    <p style="z-index: 999999; color: white; position: absolute; bottom: 5%; right: 50%;" id="debug"></p>


</div>




<script src="/js/player.js"></script>

<Script type="module">
    import { transformSrtTracks } from "/js/transformer.js"
    transformSrtTracks(video)
</Script>