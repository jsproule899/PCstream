@using Microsoft.CodeAnalysis.CSharp.Syntax
@using SQLitePCL
@model IEnumerable<MvcMovie.Models.Movie>
@{
    ViewData["Title"] = "Home";
    List<RecentlyWatched> recentlyWatched = ViewData["RecentlyWatched"] as List<RecentlyWatched> ?? [];
    List<Movie> movies = ViewData["RecentlyAddedMovies"] as List<Movie> ?? [];
    List<Season> seasons = ViewData["RecentlyAddedSeaons"] as List<Season> ?? [];
}

<style>
    progress {
        visibility: hidden;
        position: absolute;
        display: flex;
        z-index: 1;
        bottom: -1px;
        left: 50%;
        padding: 0px;
        height: 2px;
        margin: 0px;
        width: 100%;
        border-radius: 5px;
        box-shadow: 1px 1px 4px rgba(0, 0, 0, 0.2);
        transform: translate(-50%, 0%);
    }

    progress::-webkit-progress-bar {
        background-color: transparent;
        border-radius: 0px;
    }

    progress::-webkit-progress-value {
        background-color: royalblue;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
        box-shadow: 0px 0px 5px royalblue;
    }
</style>

<h1 class="my-4">Welcome to PCStream</h1>

<div class="row g-3">
    <h2 class="mb-0">Continue Watching</h2>
    <p class="text-muted mt-2">Your recently watched videos will appear here.</p>
@foreach (RecentlyWatched recent in recentlyWatched)
{
        <div class="col-2 ">
            @if (recent.Movie != null)
            {
                <a asp-controller="Videos" asp-action="Player" asp-route-id="@recent.Movie.Video.Id">
                    <div class="card shadow-sm" style="aspect-ratio: 2/3; border-radius:5px;">
                        <div class="play-button-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="grey"
                                class="bi bi-play-circle-fill play-button" viewBox="0 0 16 16">
                                <path
                                    d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814z" />
                            </svg>
                        </div>

                        <div style=" position: absolute; z-index: 1; bottom: 10px; right:10px ">
                            @for (int i = 1; i < recent.Movie.Rating / 2; i++)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gold" class="bi bi-star-fill"
                                    viewBox="0 0 16 16">
                                    <path
                                        d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            }
                        </div>
                        <progress id="progress-bar-@(recent.Movie.Video.Id)" max="100" value="0" class="episode-progress"
                            data-runtime="@recent.Movie.Runtime"
                            data-progress="@recent.Movie.Video.LastWatchedTimestamp"></progress>
                        <div class="card-body "
                            style="contain: strict; height: 100%; width: 100%; background-image: url(https://image.tmdb.org/t/p/original@(recent.Movie.Poster)); background-size: cover; border-radius:5px;">
                        </div>
                    </div>
                </a>
                <p class="card-title text-center">@recent.Movie.Title <small
                        class="card-subtitle text-center text-muted">(@recent.Movie.ReleaseDate.Year))</small></p>
            }
            else if (recent.Episode != null)
            {
                <a asp-controller="Videos" asp-action="Player" asp-route-id="@recent.Episode.Video.Id">
                    <div class="card shadow-sm" style="aspect-ratio: 2/3; border-radius:5px;">
                        <div class="play-button-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="grey"
                                class="bi bi-play-circle-fill play-button" viewBox="0 0 16 16">
                                <path
                                    d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814z" />
                            </svg>
                        </div>

                        <div style=" position: absolute; z-index: 1; bottom: 10px; right:10px ">
                            @for (int i = 1; i < recent.Episode.Rating / 2; i++)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gold" class="bi bi-star-fill"
                                    viewBox="0 0 16 16">
                                    <path
                                        d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            }
                        </div>
                        <progress id="progress-bar-@(recent.Episode.Video.Id)" max="100" value="0" class="episode-progress"
                            data-runtime="@recent.Episode.Runtime"
                            data-progress="@recent.Episode.Video.LastWatchedTimestamp"></progress>
                        <div class="card-body"
                            style="contain: strict; height: 100%; width: 100%; background-image: url(https://image.tmdb.org/t/p/original@(recent.Episode.Season.Poster)); background-size: cover; border-radius:5px;">
                        </div>
                    </div>
                </a>
                <p class="card-title text-center">@recent.Episode.Title <small class="card-subtitle text-center text-muted">(S
                        @recent.Episode.SeasonNumber E @recent.Episode.EpisodeNumber) </small></p>
            }
        </div>
}



    <div class="row g-3">
        <h2 class="mb-0 mt- ">Recently Added Movies</h2>
        @foreach (Movie m in movies)
        {
            <div class="col-2">
                <a asp-controller="Videos" asp-action="Player" asp-route-id="@m.Video.Id">
                    <div class="card shadow-sm" style="aspect-ratio: 2/3; border-radius:5px;">
                        <div class="play-button-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="grey"
                                class="bi bi-play-circle-fill play-button" viewBox="0 0 16 16">
                                <path
                                    d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814z" />
                            </svg>
                        </div>

                        <div style=" position: absolute; z-index: 1; bottom: 10px; right:10px ">
                            @for (int i = 1; i < m.Rating / 2; i++)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gold"
                                    class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path
                                        d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            }
                        </div>
                        <div class="card-body "
                            style="contain: strict; height: 100%; width: 100%; background-image: url(https://image.tmdb.org/t/p/original@(m.Poster)); background-size: cover; border-radius:5px;">
                        </div>
                    </div>
                </a>

                <p class="card-title text-center">@m.Title <small
                        class="card-subtitle text-center text-muted">(@m.ReleaseDate.Year))</small></p>
                <p class="card-subtitle text-center text-muted">@((int)m.Runtime / 60) Hr @(m.Runtime % 60)
                    mins</p>
            </div>
        }
    </div>


    <div class="row g-3">
        <h2 class="mb-0 mt-4">Recently Added Shows</h2>
        @foreach (Season s in seasons)
        {
            <div class="col-2">
                <a asp-controller="Shows" asp-action="Season" asp-route-id="@s.Show.Id"
                    asp-route-seasonNum="@s.SeasonNumber">
                    <div class="card shadow-sm" style="aspect-ratio: 2/3; border-radius:5px;">
                        <div class="play-button-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="grey"
                                class="bi bi-play-circle-fill play-button" viewBox="0 0 16 16">
                                <path
                                    d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814z" />
                            </svg>
                        </div>

                        <div style=" position: absolute; z-index: 1; bottom: 10px; right:10px ">
                            @for (int i = 1; i < s.Rating / 2; i++)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="gold"
                                    class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path
                                        d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            }
                        </div>
                        <div class="card-body "
                            style="contain: strict; height: 100%; width: 100%; background-image: url(https://image.tmdb.org/t/p/original@(s.Poster)); background-size: cover; border-radius: 5px;">
                        </div>
                    </div>
                </a>

                <p class="card-title text-center">@s.Show.Title <small
                        class="card-subtitle text-center text-muted">(@s.Title)</small></p>

            </div>
        }
    </div>

    <script src="/js/showProgress.js" />